# Copy to .env.local for local dev, and set the same keys in your Vercel Project
# Settings → Environment Variables. Never commit real secret values.

# Paytm — use 'staging' with the test MID/key, 'production' with live credentials
PAYTM_MID=your_paytm_mid
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging

# Web3Forms access key — emailed from the browser on the thank-you page.
# (Web3Forms' free plan only accepts client-side submissions; NEXT_PUBLIC exposes it to the browser, which is expected for this public key.)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
